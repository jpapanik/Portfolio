<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #f9f8f6;
    --surface: #ffffff;
    --text: #1a1a18;
    --muted: #6b6b66;
    --faint: #a8a89e;
    --border: rgba(0,0,0,0.09);
    --border-med: rgba(0,0,0,0.14);
    --accent: #2563A8;
    --accent-bg: #eef4fb;
    --tag-bg: #f0f0ec;
    --tag-text: #4a4a44;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 15px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  /* NAV */
  nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(249,248,246,0.88);
    backdrop-filter: blur(12px);
    border-bottom: 0.5px solid var(--border);
    padding: 0 2rem;
    display: flex; align-items: center; justify-content: space-between;
    height: 56px;
  }
  .nav-name { font-size: 14px; font-weight: 500; letter-spacing: -0.01em; }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { font-size: 13px; color: var(--muted); text-decoration: none; transition: color 0.15s; }
  .nav-links a:hover { color: var(--text); }

  /* HERO */
  .hero {
    max-width: 760px; margin: 0 auto;
    padding: 5rem 2rem 4rem;
    border-bottom: 0.5px solid var(--border);
  }
  .hero-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 11px; letter-spacing: 0.1em;
    color: var(--accent); text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 300; letter-spacing: -0.03em;
    line-height: 1.1; margin-bottom: 1rem;
    color: var(--text);
  }
  .hero h1 em { font-style: normal; font-weight: 500; }
  .hero-bio {
    font-size: 15px; color: var(--muted);
    max-width: 520px; margin-bottom: 2rem; line-height: 1.75;
  }
  .hero-contacts { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .hero-contacts a {
    font-size: 13px; color: var(--muted); text-decoration: none;
    display: flex; align-items: center; gap: 6px;
    transition: color 0.15s;
  }
  .hero-contacts a:hover { color: var(--text); }
  .hero-contacts svg { width: 14px; height: 14px; flex-shrink: 0; }

  /* MAIN */
  main { max-width: 760px; margin: 0 auto; padding: 0 2rem 5rem; }

  section { padding: 3.5rem 0; border-bottom: 0.5px solid var(--border); }
  section:last-child { border-bottom: none; }

  .section-header {
    display: flex; align-items: baseline; gap: 1rem;
    margin-bottom: 2rem;
  }
  .section-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }
  .section-line { flex: 1; height: 0.5px; background: var(--border); }

  /* SKILLS */
  .skill-group { margin-bottom: 1.5rem; }
  .skill-group:last-child { margin-bottom: 0; }
  .skill-group-name {
    font-size: 11px; font-weight: 500; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--faint);
    margin-bottom: 0.6rem;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag {
    font-size: 12px; padding: 4px 12px;
    background: var(--tag-bg); color: var(--tag-text);
    border-radius: 99px;
    border: 0.5px solid var(--border-med);
  }
  .tag.accent {
    background: var(--accent-bg); color: var(--accent);
    border-color: rgba(37,99,168,0.2);
  }

  /* PROJECTS */
  .projects-grid { display: flex; flex-direction: column; gap: 1.5rem; }
  .project-card {
    background: var(--surface);
    border: 0.5px solid var(--border-med);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .project-img {
    width: 100%; height: 220px;
    object-fit: cover; object-position: top;
    display: block;
    border-bottom: 0.5px solid var(--border);
  }
  .project-body { padding: 1.25rem 1.5rem 1.5rem; }
  .project-title {
    font-size: 15px; font-weight: 500; margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }
  .project-desc { font-size: 13px; color: var(--muted); line-height: 1.7; margin-bottom: 1rem; }
  .project-tech { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 1rem; }
  .project-tech span {
    font-family: 'DM Mono', monospace;
    font-size: 11px; padding: 3px 10px;
    background: var(--accent-bg); color: var(--accent);
    border-radius: 99px;
    border: 0.5px solid rgba(37,99,168,0.15);
  }
  .project-placeholder {
    font-size: 12px; color: var(--faint); font-style: italic;
    padding: 10px 14px;
    background: var(--bg);
    border-radius: var(--radius-sm);
    border: 0.5px dashed var(--border-med);
  }

  /* EDUCATION */
  .edu-list { display: flex; flex-direction: column; gap: 0; }
  .edu-item {
    display: grid; grid-template-columns: 110px 1fr;
    gap: 0 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 0.5px solid var(--border);
  }
  .edu-item:last-child { border-bottom: none; }
  .edu-period {
    font-family: 'DM Mono', monospace;
    font-size: 11px; color: var(--faint);
    padding-top: 3px;
    line-height: 1.5;
  }
  .edu-content h3 { font-size: 14px; font-weight: 500; margin-bottom: 3px; }
  .edu-content .school { font-size: 13px; color: var(--muted); margin-bottom: 6px; }
  .edu-content .courses { font-size: 12px; color: var(--faint); line-height: 1.7; }

  /* FOOTER */
  footer {
    text-align: center; padding: 2rem;
    font-size: 12px; color: var(--faint);
    border-top: 0.5px solid var(--border);
  }

  @media (max-width: 600px) {
    nav { padding: 0 1rem; }
    .hero, main { padding-left: 1.25rem; padding-right: 1.25rem; }
    .edu-item { grid-template-columns: 1fr; gap: 4px; }
    .edu-period { padding-top: 0; }
    .nav-links { gap: 1rem; }
  }
</style>
</head>
